-- taxa de agendamento (conversas / agendamentos)
WITH stats AS (
  SELECT
    (
      SELECT COUNT(*)::float
      FROM "Conversations" c
      WHERE "finishedBy" = 'ASSISTANT'
        AND "finishedById" = '0880d4a7-3602-430d-b925-e4276046945f'
        AND "createdAt" BETWEEN '2026-01-01 00:00:00' AND '2026-02-01 00:00:00'
    ) AS total_conversas,
    (
      SELECT COUNT(*)::float
      FROM "GoogleCalendarEvents"
      WHERE "assistantId" = '0880d4a7-3602-430d-b925-e4276046945f'
        AND "createdAt" BETWEEN '2026-01-01 00:00:00' AND '2026-02-01 00:00:00'
    ) AS total_agendamentos
)
SELECT
  total_conversas,
  total_agendamentos,
  CASE
    WHEN total_conversas = 0 THEN 0
    ELSE (total_agendamentos / total_conversas) * 100
  END AS taxa_conversao_percentual
FROM stats;


-- cancelamentos de agendamento
SELECT
  oa.id,
  oa.name,
  COUNT(e.*)
FROM "GoogleCalendarEvents" e JOIN "OpenaiAssistants" oa ON e."assistantId"=oa.id
WHERE oa."id"='0880d4a7-3602-430d-b925-e4276046945f'
  AND e."createdAt" BETWEEN '2026-01-01 00:00:00' AND '2026-02-01 00:00:00'
  AND e."isCancelled" = true
GROUP BY oa.id, oa.name;

