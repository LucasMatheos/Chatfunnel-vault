-- numero de agendamentos realizados de todos os agentes da conta (com filtro de data)
SELECT
  oa.id,
  oa.name,
  COUNT(e.id) AS event_count
FROM "OpenaiAssistants" oa
LEFT JOIN "GoogleCalendarEvents" e 
  ON oa.id = e."assistantId"
  AND e."createdAt" BETWEEN '2026-01-01 00:00:00' AND '2026-02-01 00:00:00'
JOIN "Accounts" a 
  ON oa."accountId" = a.id
WHERE a."id" = '9785e32a-4d87-41a9-acf2-98b491db5b79'
GROUP BY oa.id, oa.name
ORDER BY event_count DESC;

-- numero de agendamentos realizados por agente (com filtro de data)
SELECT
  oa.id,
  oa.name,
  COUNT(e.*)
FROM "GoogleCalendarEvents" e JOIN "OpenaiAssistants" oa ON e."assistantId"=oa.id
WHERE oa."id"='0880d4a7-3602-430d-b925-e4276046945f'
 AND e."createdAt" BETWEEN '2026-01-01 00:00:00' AND '2026-02-01 00:00:00'
GROUP BY oa.id, oa.name;

