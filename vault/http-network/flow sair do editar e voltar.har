ediaUrl\":null,\"media\":null,\"templateId\":null,\"whatsappTemplateId\":null,\"channelId\":null},{\"id\":\"7dd04b1d-dbf1-45ab-8de3-a4b9f96701ab\",\"flowType\":\"DELAY\",\"text\":null,\"delayDuration\":5,\"nextStepInputReceivedId\":null,\"nextStepInputDontReceivedId\":null,\"timeForExecuteCron\":0,\"customFields\":[],\"buttons\":[],\"mediaUrl\":null,\"media\":null,\"templateId\":null,\"whatsappTemplateId\":null,\"channelId\":null}],\"assistantId\":null,\"assistantStartCommand\":null,\"assistantType\":\"START_ASSISTANT\",\"overrideAssistantStartCommand\":false,\"actionType\":null,\"useRequest\":false,\"httpMethod\":null,\"httpLink\":null,\"httpBody\":null,\"tags\":[],\"httpHeaders\":[],\"httpResponseMapping\":[],\"delayType\":null,\"delayDuration\":null,\"delayUnit\":null,\"delayDate\":null,\"delayTimezone\":null,\"hasDelayLimit\":false,\"delayLimitStartHour\":null,\"delayLimitEndHour\":null,\"delayLimitWeekdays\":[],\"testCases\":[],\"stepsConditions\":[],\"runAutomationId\":null,\"kanbanActionType\":null,\"kanbanId\":null,\"kanbanColumnId\":null,\"kanbanModerators\":[],\"stepChatActionType\":null,\"moderatorId\":null,\"moderator\":null,\"nextStepId\":null,\"answerStepId\":null,\"unanswerStepId\":null,\"afterAssistantStepId\":null,\"x\":4225,\"y\":500,\"channelId\":null},{\"id\":\"dc8fbf12-300c-45b1-acda-09122e8a70a4\",\"stepType\":\"WHATSAPP_ACTIONS\",\"messageType\":\"SUBMISSION_WINDOW\",\"flowId\":null,\"flows\":[{\"id\":\"2ce251a2-a534-47b0-8881-698bdbbcbc9b\",\"flowType\":\"TEXT\",\"text\":\"plaintext::Agora você pode escolher:\\n🚚 Coleta em casa:Pagamento no próximo dia útil. Taxa de R$40.\\n🏪 Atendimento presencial: Pagamento na hora.\\nQual opção você prefere? \",\"delayDuration\":null,\"nextStepInputReceivedId\":null,\"nextStepInputDontReceivedId\":null,\"timeForExecuteCron\":0,\"customFields\":[],\"buttons\":[{\"id\":\"5452a21e-7620-4504-b466-46f97e86f2c6\",\"title\":\"Coleta em casa\",\"templateButtonId\":null,\"messageFlowId\":\"2ce251a2-a534-47b0-8881-698bdbbcbc9b\",\"nextStepId\":\"1da21779-386c-42b1-99d6-10217d646c53\",\"useLink\":false,\"url\":\"\",\"whatsappTemplateButtonId\":null},{\"id\":\"14580bf2-ef30-4268-8080-9d1b160b734f\",\"title\":\"Presencial\",\"templateButtonId\":null,\"messageFlowId\":\"2ce251a2-a534-47b0-8881-698bdbbcbc9b\",\"nextStepId\":\"c1eb9084-0d72-480a-a491-785796e9326d\",\"useLink\":false,\"url\":\"\",\"whatsappTemplateButtonId\":null}],\"mediaUrl\":null,\"media\":null,\"templateId\":null,\"whatsappTemplateId\":null,\"channelId\":null}],\"assistantId\":null,\"assistantStartCommand\":null,\"assistantType\":\"START_ASSISTANT\",\"overrideAssistantStartCommand\":false,\"actionType\":null,\"useRequest\":false,\"httpMethod\":null,\"httpLink\":null,\"httpBody\":null,\"tags\":[],\"httpHeaders\":[],\"httpResponseMapping\":[],\"delayType\":null,\"delayDuration\":null,\"delayUnit\":null,\"delayDate\":null,\"delayTimezone\":null,\"hasDelayLimit\":false,\"delayLimitStartHour\":null,\"delayLimitEndHour\":null,\"delayLimitWeekdays\":[],\"testCases\":[],\"stepsConditions\":[],\"runAutomationId\":null,\"kanbanActionType\":null,\"kanbanId\":null,\"kanbanColumnId\":null,\"kanbanModerators\":[],\"stepChatActionType\":null,\"moderatorId\":null,\"moderator\":null,\"nextStepId\":null,\"answerStepId\":null,\"unanswerStepId\":null,\"afterAssistantStepId\":null,\"x\":10025,\"y\":550,\"channelId\":null},{\"id\":\"512eeb85-2ced-49de-ac8e-67a2fd0b12d4\",\"stepType\":\"WHATSAPP_ACTIONS\",\"messageType\":\"SUBMISSION_WINDOW\",\"flowId\":null,\"flows\":[{\"id\":\"219c10d9-0229-45dc-b48f-13f4be09e82d\",\"flowType\":\"TEXT\",\"text\":\"plaintext::Processo de coleta:\\n\\n🚚 *Coleta*: Diga o melhor dia dentro dos próximos 3 dias úteis! Faremos pela manhã, entre 8h-12h (sem horário fixo). Avisaremos ao chegar e aguardaremos até 10 minutos na portaria.\\nO aparelho precisa estar *resetado, sem senha e ligando*. Sem isso não conseguimos fazer testes e seguir.\\n\\n🔎 *Análise*: Após a coleta, verificaremos o aparelho no mesmo dia e, estando nas condições que você informou, pagamos exatamente o valor da proposta.\\n\\n📄*Contrato*: Antes do pagamento, enviamos um contrato digital para assinatura no seu e-mail.\\n\\n🔄 *Revisão de valor*: Se verificarmos defeitos não reportados na cotação e houver alteração no preço, solicitaremos sua aprovação antes de seguir. Se não quiser seguir com a venda, devolvemos o aparelho sem custo no próximo dia útil.\\n\\n🤝 A coleta tem uma taxa de R$ 40, que é descontada do valor que você recebe no Pix.\\n\\n💸*Pagamento*: Após a assinatura, o Pix é feito no próximo dia útil.\\n\\n*Preferindo pagamento na hora, siga para nossa opção presencial!*\",\"delayDuration\":null,\"nextStepInputReceivedId\":null,\"nextStepInputDontReceivedId\":null,\"timeForExecuteCron\":0,\"customFields\":[],\"buttons\":[{\"id\":\"7df6e649-3bfb-45f3-a6d6-11d47e872095\",\"title\":\"Agendar minha coleta\",\"templateButtonId\":null,\"messageFlowId\":\"219c10d9-0229-45dc-b48f-13f4be09e82d\",\"nextStepId\":\"f6daf536-dc6f-4f9e-8fae-5d6a50fddf59\",\"useLink\":false,\"url\":\"\",\"whatsappTemplateButtonId\":null},{\"id\":\"85413165-8b55-4458-909d-584927012c5f\",\"title\":\"Opção presencial\",\"templateButtonId\":null,\"messageFlowId\":\"219c10d9-0229-45dc-b48f-13f4be09e82d\",\"nextStepId\":\"76bf0cf4-51eb-4f43-9586-1a9a56fe6157\",\"useLink\":false,\"url\":\"\",\"whatsappTemplateButtonId\":null}],\"mediaUrl\":null,\"media\":null,\"templateId\":null,\"whatsappTemplateId\":null,\"channelId\":null}],\"assistantId\":null,\"assistantStartCommand\":null,\"assistantType\":\"START_ASSISTANT\",\"overrideAssistantStartCommand\":false,\"actionType\":null,\"useRequest\":false,\"httpMethod\":null,\"httpLink\":null,\"httpBody\":null,\"tags\":[],\"httpHeaders\":[],\"httpResponseMapping\":[],\"delayType\":null,\"delayDuration\":null,\"delayUnit\":null,\"delayDate\":null,\"delayTimezone\":null,\"hasDelayLimit\":false,\"delayLimitStartHour\":null,\"delayLimitEndHour\":null,\"delayLimitWeekdays\":[],\"testCases\":[