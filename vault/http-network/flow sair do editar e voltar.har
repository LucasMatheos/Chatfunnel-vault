              "value": "{\"group\":\"cf-nel\",\"max_age\":604800,\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=gVJnCn7oso4UcaoR8FwtEZ6Da9EQrLmUGOvRsGl5cNImErYlh1Y0PCQwDWTnrKu3yCHWvgL%2B3K8TCrqenQdRmKAPfaHPIbSVodvGgOeDh1yocMZPIYq%2FraCQFDFVDjVy1jURmbj4mHI%3D\"}]}"
