              "value": "{\"group\":\"cf-nel\",\"max_age\":604800,\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=wYp55r0LZrYOYVAxX8RhOICV2JvPrKZ7E8NqyRV1PbZSUxxYsA%2BVHqUPfh%2FN5yGw%2FUMbCDf0f%2BDN6WHWI5FK7uYhgXrASNmJEAhktVSV1SUaHKcocPem9uWW0tRWTdLzpDK4FaQyJ7Q%3D\"}]}"
